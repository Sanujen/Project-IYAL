# ============================================================================
# Project IYAL — Environment Configuration (.env)
# ============================================================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Zero-Cost Database Configuration
# Default: Embedded SQLite in WAL mode stored in ./data/iyal.db (100% free, zero external service needed)
# Optional: You can also point this to a PostgreSQL database URL if desired:
# DATABASE_URL=postgresql://user:password@localhost:5432/iyal_db
DATA_DIR=./data
LOG_DIR=./logs

# Predefined Superadmin Account (Seeded automatically on startup)
SUPERADMIN_EMAIL=superadmin@gmail.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=IyalAdmin@2026

# JWT & Google OAuth 2.0 (Optional: set GOOGLE_CLIENT_ID to enable 1-click Sign in with Google on /admin)
JWT_SECRET_KEY=change-this-to-a-long-random-hex-secret-in-production
JWT_EXPIRE_HOURS=12
GOOGLE_CLIENT_ID=

# In-Monolith DDoS, Rate Limiting & Brute-Force Protection
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_INFERENCE_PER_MIN=30
RATE_LIMIT_FEEDBACK_PER_MIN=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
IP_BAN_VIOLATION_THRESHOLD=10
IP_BAN_DURATION_SECONDS=600

# Payload & Concurrency Limits
MAX_INPUT_CHARS=15000
MAX_UPLOAD_MB=5
MAX_CONCURRENT_INFERENCES=4

